{
  "expo": {
    "name": "TruckSOS",
    "slug": "trucksos",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trucksos",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3A7D",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCJQ0J-eY5VUFCZbbMHgX5f308YjubNWvI"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andeaf.trucksos",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.andeaf.trucksos",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "en": "./locales/ios/en.json",
      "ro": "./locales/ios/ro.json",
      "de": "./locales/ios/de.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3A7D",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#0E3A7D",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TruckSOS uses your location to attach your truck's position to your breakdown announcement, so nearby mechanics can find you on the map.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TruckSOS accesses your photo library so you can attach photos to your breakdown announcements and conversations.",
          "cameraPermission": "TruckSOS uses the camera so you can photograph the breakdown and attach the photo to your announcement or send it in a conversation.",
          "microphonePermission": "TruckSOS uses the microphone to record audio when you capture a video to send in a conversation."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TruckSOS accesses your photo library so you can attach photos to your breakdown announcements and conversations.",
          "savePhotosPermission": "TruckSOS saves photos received in conversations to your photo library, only when you tap the download button.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc737a62-2ec0-458e-b216-8248cd4b745e"
      }
    }
  }
}

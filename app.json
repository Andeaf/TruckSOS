{
  "expo": {
    "name": "TruckSOS",
    "slug": "trucksos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expoinit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andeaf.trucksos"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TruckSOS folosește locația ta pentru a completa automat coordonatele GPS ale anunțului tău."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TruckSOS accesează pozele tale ca să le poți atașa la anunțuri și în conversații.",
          "cameraPermission": "TruckSOS folosește camera ca să poți fotografia defecțiunea și să o atașezi la anunț sau în chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TruckSOS accesează galeria foto ca să poți atașa poze la anunțuri și în conversații.",
          "savePhotosPermission": "TruckSOS salvează în galeria ta pozele primite în conversații.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc737a62-2ec0-458e-b216-8248cd4b745e"
      }
    }
  }
}
